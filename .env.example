# Optional. When both are set the app uses Supabase (accounts + cloud storage).
# When either is missing the app runs in local-only mode (events stay in this browser).
# Use the project's public "anon" key only. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
